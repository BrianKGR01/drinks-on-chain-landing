# Sitios del ecosistema (sin dominio comprado aún: valores de desarrollo)
# Marketplace (catálogo, visor /b, "Entrar"). Aún no tiene URL pública: sin definir en producción, sus enlaces se
# ocultan o llevan a una página de este sitio (/vinos, /como-funciona#escanear). Se lee al compilar.
NEXT_PUBLIC_URL_APP=http://localhost:3005
NEXT_PUBLIC_URL_BODEGAS=http://localhost:3000
# Origen canónico del sitio (metadataBase, sitemap, robots). Sin definir: Vercel en producción, localhost:3001 en desarrollo.
# NEXT_PUBLIC_SITE_URL=https://drinks-on-chain-landing.vercel.app
# API del backend (variable de servidor, sin NEXT_PUBLIC_). El navegador llama a /api/v1/* de este sitio y
# src/proxy.ts la reescribe a ${API_ORIGIN}/v1/* (plan/03 §6, P-1). Sin definir: /lista-de-espera avisa de que el
# envío no está disponible y da un correo de contacto. La página la lee al compilar: cambiarla exige un nuevo despliegue.
# API_ORIGIN=http://localhost:4000
# Firma de la IP del cliente para el backend (O1-OPS-1): variable de servidor (nunca NEXT_PUBLIC_), el mismo valor
# que PROXY_SHARED_SECRET del backend del entorno. Sin definir: no se firma y el backend usa la IP de la conexión
# (en un evento, todas las inscripciones compartirían la IP de Vercel y el límite por IP las cortaría).
# PROXY_SHARED_SECRET=change-me
